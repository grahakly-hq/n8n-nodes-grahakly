{
  "name": "n8n-nodes-grahakly",
  "version": "0.2.7",
  "description": "n8n community node for Grahakly — send WhatsApp messages and templates and create contacts through the Grahakly API.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "grahakly",
    "whatsapp",
    "whatsapp-business",
    "messaging"
  ],
  "license": "MIT",
  "homepage": "https://grahakly.com",
  "author": {
    "name": "Grahakly",
    "email": "stepwayonline@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahakly-hq/n8n-nodes-grahakly.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GrahaklyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Grahakly/Grahakly.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
