{
  "name": "n8n-nodes-grahakly",
  "version": "0.1.0",
  "description": "n8n community node for Grahakly — send WhatsApp messages and templates and create contacts through the Grahakly API.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "grahakly",
    "whatsapp",
    "whatsapp-business",
    "messaging"
  ],
  "license": "MIT",
  "homepage": "https://grahakly.com",
  "author": {
    "name": "Grahakly",
    "email": "stepwayonline@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandasiwal/n8n-nodes-grahakly.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GrahaklyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Grahakly/Grahakly.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
